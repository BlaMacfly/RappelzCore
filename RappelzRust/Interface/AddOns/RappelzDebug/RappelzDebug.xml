<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame name="RappelzDebugFrame">
    <Size x="360" y="340"/>
    <Anchors><Anchor point="TOPLEFT" relativeTo="UIParent" relativePoint="TOPLEFT" x="18" y="-100"/></Anchors>
    <Frames>
      <FontString name="RappelzDebugTitle" text="RappelzDebug - live Lua 5.1">
        <Size x="336" y="24"/>
        <Anchors><Anchor point="TOPLEFT" x="12" y="-10"/></Anchors>
      </FontString>
      <FontString name="RappelzDebugInfo">
        <Size x="336" y="240"/>
        <Anchors><Anchor point="TOPLEFT" x="12" y="-38"/></Anchors>
      </FontString>
      <Button name="RappelzDebugButton" text="Persistent click counter">
        <Size x="336" y="32"/>
        <Anchors><Anchor point="BOTTOMLEFT" relativePoint="BOTTOMLEFT" x="12" y="12"/></Anchors>
        <Scripts><OnClick function="RappelzDebugOnClick"/></Scripts>
      </Button>
    </Frames>
    <Scripts>
      <OnLoad function="RappelzDebugOnLoad"/>
      <OnEvent function="RappelzDebugOnEvent"/>
    </Scripts>
  </Frame>
</Ui>
