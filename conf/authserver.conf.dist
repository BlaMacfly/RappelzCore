###############################################
# RappelzCore Auth Server configuration file #
###############################################
# Copiez ce fichier en « authserver.conf » à côté de authserver.exe.
# Même format qu'AzerothCore ; toute clé peut être surchargée par une variable
# d'environnement AC_<CLE> (ex. AC_LOGIN_DATABASE_INFO).
[authserver]

###################################################################################################
# PARAMÈTRES DE CONNEXION
#
#    LoginDatabaseInfo
#        Description: Base de données des comptes (schéma acore_auth d'AzerothCore).
#        Format:      "hôte;port;utilisateur;mot_de_passe;base"
#        Défaut:      "127.0.0.1;3306;acore;acore;acore_auth"

LoginDatabaseInfo = "127.0.0.1;3306;acore;acore;acore_auth"

#    LoginDatabase.WorkerThreads
#        Description: Nombre maximal de connexions MySQL simultanées.
#        Défaut:      4

LoginDatabase.WorkerThreads = 4

#    RealmServerPort
#        Description: Port d'écoute des clients (auth_port du launcher Rappelz).
#        Défaut:      4615 (valeur du client NoLimits)

RealmServerPort = 4615

#    BindIP
#        Description: Adresse d'écoute.
#        Défaut:      "0.0.0.0"

BindIP = "0.0.0.0"

#    LogLevel
#        Description: 0 erreurs, 1 avertissements, 2 informations, 3 débogage.
#        Défaut:      2

LogLevel = 2

###################################################################################################
# SÉCURITÉ (mêmes clés qu'AzerothCore)
#
#    WrongPass.MaxCount
#        Description: Nombre d'échecs de mot de passe avant bannissement automatique (0 = jamais).
#    WrongPass.BanTime
#        Description: Durée du bannissement automatique, en secondes.
#    WrongPass.BanType
#        Description: 0 = bannir l'IP (ip_banned), 1 = bannir le compte (account_banned).

WrongPass.MaxCount = 0
WrongPass.BanTime = 600
WrongPass.BanType = 0

###################################################################################################
# RAPPELZ
#
#    Rappelz.NetworkKey
#        Description: Clé RC4 du flux réseau (XRC4Cipher de SFrame.exe). Doit être identique
#                     dans le client et le worldserver.
#        Défaut:      "}h79q~B%al;k'y $E"

Rappelz.NetworkKey = "}h79q~B%al;k'y $E"

#    Rappelz.Codepage
#        Description: Code page des textes du protocole (noms de compte).
#        Défaut:      "windows-1252"

Rappelz.Codepage = "windows-1252"

#    Rappelz.AutoCreateAccounts
#        Description: Crée le compte à la première connexion s'il n'existe pas (développement).
#        Défaut:      0

Rappelz.AutoCreateAccounts = 0

#    Rappelz.ServerScreenshotUrl
#        Description: URL de l'image affichée par le client dans la liste des serveurs.

Rappelz.ServerScreenshotUrl = ""
